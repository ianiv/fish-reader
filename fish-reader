#!/usr/bin/env bash
# Starts the fish-reader server with the repo's .venv Python. fish-ui (./fish-ui in ../fish-ui) must be running.
# Usage: ./fish-reader [--port 8767] [--data-dir ./data] [--fish-ui-url http://127.0.0.1:8766] [--config config.json]
# FISH_READER_TAGGER=fake|none overrides the tagger (default from config: claude, i.e. `claude -p`).
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
PY="${FISH_READER_PYTHON:-$HERE/.venv/bin/python}"
if [ ! -x "$PY" ]; then
  echo "fish-reader: no venv. Create it: uv venv --python 3.13 .venv && uv pip install --python .venv/bin/python trafilatura" >&2
  exit 1
fi
exec "$PY" "$HERE/server/server.py" "$@"
